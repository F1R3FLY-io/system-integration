{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/F1R3FLY-io/system-integration/soak/schemas/catalog-v1.schema.json",
  "title": "F1R3FLY randomized exercise soak catalogue v1",
  "type": "object",
  "propertyNames": {"pattern": "^[\\u0000-\\u007f]*$"},
  "additionalProperties": false,
  "required": ["catalog_schema_version", "epochs"],
  "properties": {
    "catalog_schema_version": {"const": 1},
    "epochs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["epoch_id", "epoch_revision", "path", "definition_digest", "implementation_status"],
        "properties": {
          "epoch_id": {"type": "string", "pattern": "^SOAK-EPOCH-[0-9]{3}$"},
          "epoch_revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
          "path": {"type": "string", "pattern": "^epochs/SOAK-EPOCH-[0-9]{3}\\.v[1-9][0-9]*\\.yml$"},
          "definition_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "implementation_status": {"enum": ["planned", "implemented"]}
        }
      }
    }
  }
}
