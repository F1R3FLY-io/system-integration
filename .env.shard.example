# Per-host environment for the one-node-per-host compose files.
#
# Copy to .env.shard ON EACH HOST and fill in only what that host's role needs.
# A validator host holds its own validator key and no others, so losing one host
# does not expose the rest of the shard.
#
#   cp .env.shard.example .env.shard    # then edit; .env.shard is gitignored
#
#   boot host:      docker compose --env-file ../.env.shard -f compose/f1r3node-rust-boot.yml      up -d
#   validator hosts: docker compose --env-file ../.env.shard -f compose/f1r3node-rust-validator.yml up -d
#   readonly host:   docker compose --env-file ../.env.shard -f compose/f1r3node-rust-readonly.yml  up -d
#
# Each role is a separate compose file because compose interpolates every
# service in a file, so one combined file would demand keys a host must not
# hold. Each file requires only its own variables and stops with a message
# naming any that are missing, rather than selecting a default.
#
# Which variables each role needs:
#   all three  F1R3FLY_NODE_IMAGE, SHARD_NETWORK_ID, GENESIS_DIR, NODE_HOST
#   boot       + CEREMONY_PRIVATE_KEY                 (no BOOTSTRAP_* at all)
#   validator  + BOOTSTRAP_NODE_ID, BOOTSTRAP_HOST, VALIDATOR_PUBLIC_KEY,
#                VALIDATOR_PRIVATE_KEY
#   readonly   + BOOTSTRAP_NODE_ID, BOOTSTRAP_HOST

# ---------------------------------------------------------------------------
# Shard identity - IDENTICAL on all hosts
# ---------------------------------------------------------------------------

# Must differ from every shard that has run before, including "testnet", which
# is the node default. A node accepts messages only on its own network-id, so
# this is what stops nodes still holding an older chain from connecting and
# pushing high-numbered blocks into a fresh shard.
SHARD_NETWORK_ID=

# Pin it explicitly. Compose resolves :latest otherwise, and the image a shard
# was built on is not recoverable afterwards.
F1R3FLY_NODE_IMAGE=f1r3flyindustries/f1r3fly-rust:dev-<tag>

# Genesis files for THIS shard, identical on all hosts. Do not point this at
# ../genesis: that is the test shard's, and its bonds.txt names committed keys.
GENESIS_DIR=../genesis-shard

# ---------------------------------------------------------------------------
# This host
# ---------------------------------------------------------------------------

# The address the other four instances dial. If it is an RFC1918 address,
# conf/shard.conf must keep allow-private-addresses = true; if it is public,
# set that to false so an unreachable advertised address fails at startup.
NODE_HOST=

# ---------------------------------------------------------------------------
# Bootstrap reference - omit entirely on the boot host
# ---------------------------------------------------------------------------
#
# The boot compose file never reads these: a ceremony master runs with no
# bootstrap peer, and it could not reference itself anyway since its node id is
# generated with its certificate.
#
# On the other four hosts, fill these in from boot's own report once it is
# running. Its /api/status `address` field is the complete rnode:// string:
#
#   curl -s http://<boot host>:40403/api/status | grep -o '"address":"[^"]*"'
#   -> rnode://<node id>@<host>?protocol=40400&discovery=40404
#
# The node id is generated with boot's TLS certificate. To check it against the
# certificate directly (defaults.conf documents this derivation):
#
#   openssl ec -text -in node.key.pem | grep pub -A 5 | tail -n +2 \
#     | tr -d '\n[:space:]:' | sed 's/^04//' | keccak-256sum -x -l \
#     | tr -d ' -' | tail -c 41
BOOTSTRAP_NODE_ID=
BOOTSTRAP_HOST=

# ---------------------------------------------------------------------------
# Keys - set ONLY the one this host needs
# ---------------------------------------------------------------------------
#
# Generate each with:
#   node_cli generate-key-pair --save --output-dir ./keys-<role>
# which writes private_key.hex and public_key.hex.
#
# Never commit these. The readonly host needs neither.

# boot host only. Signs the genesis ceremony. This key is NOT a validator and
# must NOT appear in bonds.txt.
CEREMONY_PRIVATE_KEY=

# validator hosts only. The public key must match an entry in
# $GENESIS_DIR/bonds.txt, or the node will not be in the bond set.
VALIDATOR_PUBLIC_KEY=
VALIDATOR_PRIVATE_KEY=
