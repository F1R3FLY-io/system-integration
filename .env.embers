# Embers API Configuration
# This file configures the Embers API service to connect to f1r3node blockchain

# Server Configuration
EMBERS__PORT=3000
EMBERS__ADDRESS=::
EMBERS__LOG_LEVEL=debug

# Mainnet Cluster Configuration (Connected to your running f1r3node shard)
# These URLs point to the internal Docker network services
# gRPC services use http:// scheme (tonic gRPC library)
EMBERS__MAINNET__DEPLOY_SERVICE_URL=http://rnode.validator1:40401
EMBERS__MAINNET__PROPOSE_SERVICE_URL=http://rnode.validator1:40402
EMBERS__MAINNET__VALIDATOR_WS_API_URL=ws://rnode.validator1:40403
EMBERS__MAINNET__OBSERVER_URL=http://rnode.readonly:40403
EMBERS__MAINNET__OBSERVER_WS_API_URL=ws://rnode.readonly:40403

# Wallet and encryption keys
# SERVICE_KEY: Wallet private key for paying blockchain transaction fees
# WALLETS_ENV_KEY, AGENTS_ENV_KEY, AGENTS_TEAMS_ENV_KEY: Encryption keys for secure data storage
EMBERS__AES_ENCRYPTION_KEY=48E37E0E448C482ADEAE83CD15FE91AA4E2459ED67D707BB40EF17BB18E60EE4
EMBERS__MAINNET__SERVICE_KEY=232DADA5BBAFC0799D5F370DA04AF70CE438F69F954512B26D6FB5B560B81DFE
EMBERS__MAINNET__WALLETS_ENV_KEY=7194fdd634f8ff1cf6e5bc9fd6445f05c49b20a74ad79f5d5c66190de3ba2858
EMBERS__MAINNET__AGENTS_ENV_KEY=431609d5551ae4c4357a529866483ef0b7e6dbdb0bcd63f306188d2f72b2902e
EMBERS__MAINNET__AGENTS_TEAMS_ENV_KEY=ee8e8b28c1437cb9ce0d6caba66f2a0bcbe31caed663eec9a9a2a5215e5e559d
EMBERS__MAINNET__OSLFS_ENV_KEY=E6441631C4E164BF13A0532BF6775606965089CE3750E5ED39AAA9EC0DF81E67

# Testnet Cluster Configuration (Currently points to mainnet since testnet not deployed)
# Point to same services as mainnet for now
EMBERS__TESTNET__DEPLOY_SERVICE_URL=http://rnode.validator1:40401
EMBERS__TESTNET__PROPOSE_SERVICE_URL=http://rnode.validator1:40402
EMBERS__TESTNET__VALIDATOR_WS_API_URL=ws://rnode.validator1:40403
EMBERS__TESTNET__OBSERVER_URL=http://rnode.readonly:40403
EMBERS__TESTNET__OBSERVER_WS_API_URL=ws://rnode.readonly:40403
EMBERS__TESTNET__SERVICE_KEY=232DADA5BBAFC0799D5F370DA04AF70CE438F69F954512B26D6FB5B560B81DFE
EMBERS__TESTNET__ENV_KEY=343f1bd1ab0906c656e4bd353804ce84e9fc7162ad0aba48832c7de27aac5cb3

# Notes:
# 1. The SERVICE_KEY wallet must have sufficient REV/funds to deploy and execute contracts
# 2. The URLs use internal Docker network hostnames (rnode.validator1, rnode.readonly)
# 3. These services are part of the f1r3fly Docker network
# 4. The embers API will be accessible on http://localhost:8080 (external port mapping)
