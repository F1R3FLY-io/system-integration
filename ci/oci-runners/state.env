# OCI resource OCIDs for the CI runner stack.
# Populated by provisioning steps; sourced by launch/cleanup scripts.
# Region: us-sanjose-1

COMP=ocid1.compartment.oc1..aaaaaaaalq6bh2a6dmq4h6i3nrripxlcevv7fa3goaf7wxve52qiuocmehia
TENANCY=ocid1.tenancy.oc1..aaaaaaaaii7udpmtqhokgof6mqewbfipvbgu4ux4vvpm2gaghfnnuvgjb6fq

VCN_OCID=ocid1.vcn.oc1.us-sanjose-1.amaaaaaafozi5pya3rfaecs66o653vxbnz3v33viyulsxkcobpzizkfg7ruq
IGW_OCID=ocid1.internetgateway.oc1.us-sanjose-1.aaaaaaaa42ldapt4h7gub7m3vk3cnx7y5y7s24qyxnudjus6v6uxp2xlvoeq
DEFAULT_RT=ocid1.routetable.oc1.us-sanjose-1.aaaaaaaatu24mebvvn4cgfugjxa6fmfkq7t6yjmtqi7a7zgzpx4th46xesbq
DEFAULT_SL=ocid1.securitylist.oc1.us-sanjose-1.aaaaaaaaeffzpjriodfefkao4iariksfovxsysegxabwdvmzxdco4r5rmugq
SUBNET_OCID=ocid1.subnet.oc1.us-sanjose-1.aaaaaaaaowangcfvfzpk27wmghb5d63ee2rsvbzmtyawkvpt7pjsdaw42z2a

DG_OCID=ocid1.dynamicgroup.oc1..aaaaaaaa2arnuj4xqklzkf5xciyudo7ekugilskaspmdvvwhabxhivceb2aa
POLICY_OCID=ocid1.policy.oc1..aaaaaaaaxrbrjnjdflomdk6wfbymzbnyyqgwzr7qr3iwrxssatjib322fnea

AD=fnZP:US-SANJOSE-1-AD-1
REGION=us-sanjose-1

GH_ORG=F1R3FLY-io
GH_REPO=F1R3FLY-io/f1r3node
RUNNER_VERSION=2.334.0

# Shape sizing (user choice: 8 OCPU / 24 GB both arches)
AMD64_SHAPE=VM.Standard.E5.Flex
AMD64_OCPUS=8
AMD64_MEM_GB=24

ARM64_SHAPE=VM.Standard.A1.Flex
ARM64_OCPUS=8
ARM64_MEM_GB=24

# Baked custom images (produced by bake-image.sh). Each carries Docker,
# Python, Poetry, Rust, OCI CLI, the GH runner agent, and the staging test
# image. Boot is ~30s instead of ~3.5 min from stock Ubuntu.
AMD64_BAKED_IMAGE_OCID=ocid1.image.oc1.us-sanjose-1.aaaaaaaat4hzl53ivqcexk7wx2uaf2lio7fxlaze6rwpwqluq2o7ic5imkca
ARM64_BAKED_IMAGE_OCID=ocid1.image.oc1.us-sanjose-1.aaaaaaaavxv5m3soa7qzbiw6k4dpqdqnayxmmvmat5b7oeoqf7mfpt7thu7a

# Stock Ubuntu fallback (used only by bake-image.sh, not by launch-runner.sh)
AMD64_IMAGE_NAME=Canonical-Ubuntu-22.04-2026.04.30-1
ARM64_IMAGE_NAME=Canonical-Ubuntu-22.04-aarch64-2026.04.30-1

# SSH key paths (local)
SSH_KEY_PUB=~/.ssh/oci-ci-runner.pub
SSH_KEY_PRIV=~/.ssh/oci-ci-runner
