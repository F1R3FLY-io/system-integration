#cloud-config
# Production runner bootstrap. Assumes the base image is a baked
# golden image with all deps (Docker, Python, Poetry, Rust, OCI CLI,
# GH runner agent) already installed. This script only does the
# runner-specific steps: register, run one job, self-terminate.
#
# For the dep-install boot path (used to BAKE the golden image), see
# cloud-init-golden.yml.
#
# Template variables substituted by launch-runner.sh before submission:
#   __REG_TOKEN__       Short-lived runner registration token (`gh api`)
#   __GH_REPO__         GitHub owner/repo
#   __RUNNER_NAME__     Unique runner name (matches OCI instance name)
#   __RUNNER_LABELS__   Comma-separated labels

write_files:
  - path: /opt/runner-bootstrap.sh
    permissions: '0755'
    owner: root:root
    content: |
      #!/usr/bin/env bash
      set -euxo pipefail

      REG_TOKEN="__REG_TOKEN__"
      GH_REPO="__GH_REPO__"
      RUNNER_NAME="__RUNNER_NAME__"
      RUNNER_LABELS="__RUNNER_LABELS__"

      RUNNER_USER="runner"
      RUNNER_HOME="/opt/actions-runner"

      log() { echo "[$(date -Iseconds)] $*"; }

      log "=== Configure runner as ephemeral, repo-scoped ==="
      # No --disableupdate: if the baked image's runner version gets
      # deprecated by GitHub before the image is replaced, the runner
      # self-updates to the latest before listening for jobs.
      cd "$RUNNER_HOME"
      sudo -u "$RUNNER_USER" ./config.sh \
        --url "https://github.com/$GH_REPO" \
        --token "$REG_TOKEN" \
        --name "$RUNNER_NAME" \
        --labels "$RUNNER_LABELS" \
        --work "_work" \
        --ephemeral \
        --unattended \
        --replace

      log "=== Run runner (--ephemeral: one job, then exits) ==="
      sudo -u "$RUNNER_USER" ./run.sh || true

      log "=== Job complete; self-terminating instance via instance principal ==="
      INSTANCE_ID=$(curl -fsSL -H "Authorization: Bearer Oracle" \
        http://169.254.169.254/opc/v2/instance/id)
      /usr/local/bin/oci --auth instance_principal \
        compute instance terminate \
        --instance-id "$INSTANCE_ID" \
        --force \
        --preserve-boot-volume false 2>&1 || {
          log "WARN: instance-principal terminate failed; falling back to shutdown -h"
          shutdown -h now
        }

runcmd:
  - bash -lc '/opt/runner-bootstrap.sh 2>&1 | tee /var/log/runner-bootstrap.log'
