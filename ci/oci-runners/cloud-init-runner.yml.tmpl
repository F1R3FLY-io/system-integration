#cloud-config
# Production runner bootstrap. Assumes the base image is a baked
# golden image with all deps (Docker, Python, Poetry, Rust, OCI CLI,
# GH runner agent) already installed. This script only does the
# runner-specific steps: register, run one job, self-terminate.
#
# For the dep-install boot path (used to BAKE the golden image), see
# cloud-init-golden.yml.
#
# Template variables substituted by launch-runner.sh before submission:
#   __REG_TOKEN__                 Short-lived runner registration token (`gh api`)
#   __GH_REPO__                   GitHub owner/repo
#   __RUNNER_NAME__               Unique runner name (matches OCI instance name)
#   __RUNNER_LABELS__             Comma-separated labels
#   __RUNNER_IDLE_TIMEOUT_SECS__  Idle watchdog cap (default 2700)

write_files:
  - path: /opt/runner-bootstrap.sh
    permissions: '0755'
    owner: root:root
    content: |
      #!/usr/bin/env bash
      set -euxo pipefail

      REG_TOKEN="__REG_TOKEN__"
      GH_REPO="__GH_REPO__"
      RUNNER_NAME="__RUNNER_NAME__"
      RUNNER_LABELS="__RUNNER_LABELS__"

      RUNNER_USER="runner"
      RUNNER_HOME="/opt/actions-runner"

      # Tee to /dev/console as well as stdout. Everything this bootstrap writes
      # otherwise lands only in files on the VM (/var/log/runner-bootstrap.log,
      # /var/log/runner-run.log), which are destroyed with the instance — so a
      # runner that dies takes the only explanation with it. Serial console
      # output is captured by `oci compute instance-console-history`, a separate
      # OCI resource with its own lifecycle that survives termination and can be
      # read the next day.
      #
      # This is not hypothetical: soak run 30590630059 lost its runner 19
      # minutes in, and neither GitHub (no log uploaded) nor the VM (already
      # gone) could say why. f1r3node-rust's capture_diagnostics job greps
      # console history for the idle-watchdog kill line below; without this tee
      # that grep can never match.
      #
      # `|| true` so a missing/unwritable console can never abort the bootstrap
      # under `set -e` — diagnostics must not be load-bearing.
      log() {
        local line="[$(date -Iseconds)] $*"
        echo "$line"
        echo "$line" > /dev/console 2>/dev/null || true
      }

      # Kernel-OOM shield (f1r3node-rust#365, run 33136185540): the kernel OOM
      # killer chose Runner.Worker mid-soak; the wedge watch then read "worker
      # absent 600s", killed run.sh, and the bootstrap self-terminated the VM
      # through the normal ephemeral exit — the night's artifact died with it.
      # The node-side host guardian (f1r3node-rust PR #364) biases the WORKLOAD
      # to oom_score_adj +1000; this is the other half: pin the runner tree to
      # -1000 so the kernel can never prefer the runner over the workload.
      # oom_score_adj is inherited across fork, so pinning the bootstrap early
      # covers run.sh and every watchdog subshell; the re-assert loop exists
      # for Runner.Listener/Runner.Worker, whose self-update can re-exec them
      # outside that inheritance. Writing -1000 needs CAP_SYS_RESOURCE — the
      # bootstrap runs as root. Best-effort throughout (|| true): the shield
      # must never abort the bootstrap it exists to protect.
      protect_runner_from_oom() {
        echo "-1000" > "/proc/$$/oom_score_adj" 2>/dev/null || true
        (
          while :; do
            for pid in $(pgrep -u "$RUNNER_USER" -f 'Runner\.(Listener|Worker)' 2>/dev/null); do
              echo "-1000" > "/proc/$pid/oom_score_adj" 2>/dev/null || true
            done
            sleep 60
          done
        ) &
        log "OOM-SHIELD: runner process tree pinned to oom_score_adj -1000"
      }
      protect_runner_from_oom

      # Heartbeat: one compact console line every 2 minutes for the VM's whole
      # life. Console history only ever held the ~49s of boot output — serial
      # writes stop when the bootstrap goes quiet, so a failure at hour four of
      # a soak left nothing to read. (The pgrep watchdog fix made this worse:
      # the old buffered-log grep loop kept echoing until detection at ~226s;
      # the fixed one exits the moment a job starts.) This loop is the
      # deliberate replacement for that accidental visibility.
      #
      # Budget: the console-history buffer holds ~1MB. One line every 120s at
      # <=256 bytes is ~185KB over a 60h soak — fits with headroom. Do not
      # shrink the interval or widen the line without redoing that arithmetic.
      # Every field is best-effort (|| true / fallbacks): diagnostics must
      # never become load-bearing.
      heartbeat() {
        while :; do
          sleep 120
          local up load mem worker last
          up=$(cut -d. -f1 /proc/uptime 2>/dev/null) || up="?"
          load=$(cut -d' ' -f1-3 /proc/loadavg 2>/dev/null) || load="?"
          mem=$(awk '/MemAvailable/{printf "%dM", $2/1024}' /proc/meminfo 2>/dev/null) || mem="?"
          if pgrep -u "$RUNNER_USER" -f 'Runner\.Worker' >/dev/null 2>&1; then
            worker="worker=up"
          else
            worker="worker=down"
          fi
          last=$(tail -n 1 /var/log/runner-run.log 2>/dev/null | tr -d '\n' | cut -c1-100) || last=""
          log "HEARTBEAT up=${up}s load=[$load] mem=$mem $worker last='$last'"
        done
      }
      heartbeat &

      # Post-mortem dump: the bounded tail of every log that would otherwise
      # die with the instance, written to console at the exact moment run.sh
      # has exited — which is where the unexplained runner losses live.
      # f1r3node-rust's capture_diagnostics greps console history; the
      # POST-MORTEM prefix is its anchor. Bounded (~60 lines) so one dump
      # cannot evict the heartbeat trail from the 1MB buffer.
      post_mortem() {
        log "POST-MORTEM begin (run.sh exited, attempt $attempt)"
        tail -n 30 /var/log/runner-run.log 2>/dev/null | while IFS= read -r l; do
          log "POST-MORTEM runner-run: $l"
        done || true
        # The Listener's own session log — the file that names a session error
        # when GitHub drops the runner server-side. Newest _diag file only,
        # bounded: session losses land at the END of the current Runner log.
        find "$RUNNER_HOME/_diag" -name '*.log' -newer /var/log/runner-run.log 2>/dev/null \
          | head -n 1 | while IFS= read -r f; do
          tail -n 25 "$f" 2>/dev/null | while IFS= read -r l; do
            log "POST-MORTEM diag: $l"
          done
        done || true
        # Fallback when no _diag file is newer than the run log: newest overall.
        ls -t "$RUNNER_HOME"/_diag/Runner_*.log 2>/dev/null | head -n 1 \
          | while IFS= read -r f; do
          tail -n 15 "$f" 2>/dev/null | while IFS= read -r l; do
            log "POST-MORTEM diag2: $l"
          done
        done || true
        dmesg 2>/dev/null | tail -n 20 | while IFS= read -r l; do
          log "POST-MORTEM dmesg: $l"
        done || true
        # kern.log persists via rsyslog where the dmesg ring buffer is
        # volatile; on c7fd9f it was kern.log, not the ring, that held the
        # OOM-kill line that named the root cause.
        tail -n 15 /var/log/kern.log 2>/dev/null | while IFS= read -r l; do
          log "POST-MORTEM kern: $l"
        done || true
        docker ps -a --format '{{.Names}} {{.Status}}' 2>/dev/null | head -n 10 | while IFS= read -r l; do
          log "POST-MORTEM docker: $l"
        done || true
        log "POST-MORTEM end"
      }

      # Durable post-mortem (run 33136185540): everything post_mortem writes
      # goes to the serial console of a VM that self-terminates seconds later.
      # That run's OOM evidence was unrecoverable — the workflow-side capture
      # job ran 10 minutes after the instance was deleted and got metadata
      # only. Freeform tags on the instance record ARE readable off the dead
      # VM (the node-side guardian's soak-health tag proved the channel), and
      # instance-principal update needs no new IAM. Constraints shaping this:
      # a tag value caps at 256 chars, OCI allows 10 freeform tags per
      # instance, and `instance update --freeform-tags` REPLACES the whole
      # map — so the existing tags (purpose / series / soak-deadline-epoch /
      # soak-health) are fetched and merged, and the post-mortem spends at
      # most 4 keys (pm0..pm3), fewer when free slots are short. If the
      # fetch itself fails the pm tags are written alone: on a VM seconds
      # from deletion, preserving the evidence outranks preserving tags
      # nobody will read again. Best-effort throughout: a failed tag write
      # must never delay self-termination.
      persist_post_mortem() {
        local iid existing content merged
        iid=$(curl -fsSL -H "Authorization: Bearer Oracle" \
          http://169.254.169.254/opc/v2/instance/id 2>/dev/null) || return 0
        [ -n "$iid" ] || return 0
        content=$(
          {
            echo "attempt=$attempt exit-path post-mortem"
            tail -n 1 /var/log/runner-run.log 2>/dev/null
            dmesg 2>/dev/null | grep -iE 'out of memory|oom|killed process' | tail -n 4
            grep -iE 'out of memory|oom|killed process' /var/log/kern.log 2>/dev/null | tail -n 4
            dmesg 2>/dev/null | tail -n 3
          } | tr '\n' '|' | tr -d '"\\'
        ) || true
        [ -n "$content" ] || return 0
        existing=$(/usr/local/bin/oci --auth instance_principal compute instance get \
          --instance-id "$iid" --query 'data."freeform-tags"' \
          --raw-output 2>/dev/null) || existing='{}'
        merged=$(python3 -c '
      import json, sys
      try:
          tags = json.loads(sys.argv[1]) or {}
      except Exception:
          tags = {}
      content = sys.argv[2]
      chunks = [content[i : i + 250] for i in range(0, len(content), 250)][:4]
      taken = len([k for k in tags if not k.startswith("pm")])
      free = max(0, 10 - taken)
      for i, chunk in enumerate(chunks[:free]):
          tags["pm%d" % i] = chunk
      print(json.dumps(tags))
      ' "$existing" "$content" 2>/dev/null) || return 0
        [ -n "$merged" ] || return 0
        /usr/local/bin/oci --auth instance_principal compute instance update \
          --instance-id "$iid" --freeform-tags "$merged" \
          --force >/dev/null 2>&1 || return 0
        log "POST-MORTEM persisted to freeform tags (pm0..)"
      }

      # Wedge escape. Live-VM evidence from soak c7fd9f (2026-08-01): GitHub
      # deregistered the runner and failed the job, but Runner.Listener never
      # exited — run.sh blocked the bootstrap's `wait` forever, so
      # self-terminate never ran and the VM idled until the reaper (16 OCPU,
      # hours of burn; the leaked-VM pattern all week fits this signature).
      # Console showed nothing because every exit-path log sits AFTER `wait`.
      #
      # Once a job has started, Runner.Worker exists within seconds; on an
      # ephemeral runner the listener exits promptly after the worker finishes.
      # A listener alive with the worker continuously absent for 10 minutes is
      # wedged or session-lost — kill run.sh so the normal ephemeral exit path
      # (post_mortem, then self-terminate) runs instead of leaking the VM.
      WEDGE_TIMEOUT_SECS=600
      wedge_watch() {
        local absent=0
        while kill -0 "$RUN_PID" 2>/dev/null; do
          if pgrep -u "$RUNNER_USER" -f 'Runner\.Worker' >/dev/null 2>&1; then
            absent=0
          else
            absent=$((absent + 60))
          fi
          if [ "$absent" -ge "$WEDGE_TIMEOUT_SECS" ]; then
            log "WEDGE: worker absent ${absent}s with listener still up; killing run.sh to force the ephemeral exit path."
            kill "$RUN_PID" 2>/dev/null || true
            return 0
          fi
          sleep 60
        done
      }

      log "=== Configure runner as ephemeral, repo-scoped ==="
      # No --disableupdate: if the baked image's runner version gets
      # deprecated by GitHub before the image is replaced, the runner
      # self-updates to the latest before listening for jobs.
      cd "$RUNNER_HOME"
      sudo -u "$RUNNER_USER" ./config.sh \
        --url "https://github.com/$GH_REPO" \
        --token "$REG_TOKEN" \
        --name "$RUNNER_NAME" \
        --labels "$RUNNER_LABELS" \
        --work "_work" \
        --ephemeral \
        --unattended \
        --replace

      log "=== Run runner (--ephemeral: one job, then exits) ==="
      # Idle watchdog. run.sh blocks indefinitely waiting for a job. If this
      # runner was over-provisioned (more runners launched than matrix jobs) or
      # its run was cancelled, no job ever arrives, run.sh never returns, and the
      # self-terminate below never runs — the VM leaks (this is exactly how the
      # fleet of idle runners accumulated). Generous cap: once a job is picked up
      # we let it finish; if none arrives within the timeout we kill run.sh and
      # fall through to self-terminate.
      # Launch-parameterized (run 33208755550): the Heavy Pipeline launches its
      # arm64 runner pair up front, but arm64-subprocess queues only after
      # arm64-docker completes — the second runner idled past the 45-minute
      # default and self-terminated ~10 minutes before its leg queued, which
      # hung the pipeline with no runner alive. launch-runner.sh substitutes
      # the caller's RUNNER_IDLE_TIMEOUT_SECS (default 2700) so a launch that
      # serves a sequential pipeline can raise this cap without loosening the
      # leak guardrail for every other runner.
      IDLE_TIMEOUT_SECS=__RUNNER_IDLE_TIMEOUT_SECS__   # default 2700 = 45 min with no job
      # Forced-update retry. When the baked agent version falls below GitHub's
      # enforced minimum, the service triggers a self-update at job-assignment
      # time ("Runner update in progress"). The update restart can kill run.sh
      # before the job executes; without a retry the bootstrap would read that
      # exit as "job complete" and self-terminate a jobless VM (2026-07-07
      # incident: entire 20-VM batches died this way and starved the CI queue).
      # The ephemeral registration stays valid until a job completes, so
      # re-running run.sh (now on the updated agent) resumes listening. Retry
      # ONLY on the update signature — any other exit falls through to
      # self-terminate exactly as before.
      MAX_RUN_ATTEMPTS=3
      attempt=1
      while :; do
        : > /var/log/runner-run.log
        sudo -u "$RUNNER_USER" ./run.sh > /var/log/runner-run.log 2>&1 &
        RUN_PID=$!
        rm -f /run/runner-idle-timeout
        (
          elapsed=0
          while kill -0 "$RUN_PID" 2>/dev/null; do
            # Is a job running? Ask the process table, not the log.
            #
            # This used to grep /var/log/runner-run.log for "Running job:".
            # run.sh's stdout is redirected to a FILE, so .NET block-buffers it
            # (~4KB) while the runner's startup output is only a few hundred
            # bytes — the line can sit unflushed indefinitely. The watchdog then
            # reads an apparently jobless runner and kills run.sh mid-job at the
            # timeout, which puts EVERY job longer than
            # IDLE_TIMEOUT_SECS-minus-boot at risk. The merge-recovery soak is
            # exactly that shape, and this is the leading explanation for soak
            # run 30590630059 losing its runner 19 minutes in (VM healthy,
            # agent gone, no GitHub log).
            #
            # Runner.Listener forks a Runner.Worker per job, so the process
            # table answers immediately and cannot buffer. The log grep is kept
            # as a secondary signal: it costs nothing, and it still catches the
            # case where a worker has exited but the listener has not yet
            # returned.
            # Scoped to $RUNNER_USER: the worker runs as that user (run.sh is
            # started with `sudo -u`), while this watchdog runs as root. Without
            # -u, any process on the box whose command line happens to contain
            # the pattern reads as "a job is running" and the watchdog stands
            # down forever — the VM then never self-terminates and leaks.
            # The dot is escaped because -f takes an ERE, where "." is any char.
            if pgrep -u "$RUNNER_USER" -f 'Runner\.Worker' >/dev/null 2>&1 \
              || grep -q "Running job:" /var/log/runner-run.log 2>/dev/null; then
              log "Job detected; idle watchdog standing down; wedge watch engaged."
              # Phase 2: don't just exit — a wedged/session-lost listener would
              # block `wait` forever with no one watching (see wedge_watch).
              wedge_watch
              exit 0
            fi
            if [ "$elapsed" -ge "$IDLE_TIMEOUT_SECS" ]; then
              log "Idle ${IDLE_TIMEOUT_SECS}s with no job; killing runner to self-terminate."
              touch /run/runner-idle-timeout
              kill "$RUN_PID" 2>/dev/null || true
              exit 0
            fi
            sleep 15
            elapsed=$((elapsed + 15))
          done
        ) &
        WATCHDOG_PID=$!
        wait "$RUN_PID" 2>/dev/null || true
        kill "$WATCHDOG_PID" 2>/dev/null || true
        if grep -q "completed with result:" /var/log/runner-run.log 2>/dev/null; then
          break   # job ran to completion — the normal ephemeral exit
        fi
        if [ -f /run/runner-idle-timeout ]; then
          break   # idle timeout — proceed to self-terminate
        fi
        if grep -q "Runner update in progress" /var/log/runner-run.log 2>/dev/null \
          && [ "$attempt" -lt "$MAX_RUN_ATTEMPTS" ]; then
          attempt=$((attempt + 1))
          log "run.sh exited during forced self-update; retrying (attempt $attempt/$MAX_RUN_ATTEMPTS)"
          continue
        fi
        break   # unrecognized exit — preserve pre-existing terminate behavior
      done

      post_mortem || true
      persist_post_mortem || true

      log "=== Job complete (or idle timeout); self-terminating instance via instance principal ==="
      INSTANCE_ID=$(curl -fsSL -H "Authorization: Bearer Oracle" \
        http://169.254.169.254/opc/v2/instance/id)
      /usr/local/bin/oci --auth instance_principal \
        compute instance terminate \
        --instance-id "$INSTANCE_ID" \
        --force \
        --preserve-boot-volume false 2>&1 || {
          log "WARN: instance-principal terminate failed; falling back to shutdown -h"
          shutdown -h now
        }

runcmd:
  - bash -lc '/opt/runner-bootstrap.sh 2>&1 | tee /var/log/runner-bootstrap.log'
