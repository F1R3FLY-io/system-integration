# Ignore all service subdirectories but track the services directory itself
services/*/

tmp

# Subprocess provider per-session data dirs (data + logs from
# `pytest --provider=subprocess` runs)
integration-tests/.subprocess-data/

# Archived node logs from teardown (per-session subdirs of <name>.log
# files). Captured by Provider.destroy_* paths before resources are
# removed, so post-failure inspection survives container/process teardown.
integration-tests/log-archive/

