# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=atproto

LOG_ENABLED=true
LOG_LEVEL=debug
NODE_ENV=development
DEBUG=*

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# BSKY AppView Service
# Public URL: how BSKY is accessed from the host (browser/external clients)
BSKY_PUBLIC_URL=http://localhost:2584
BSKY_SERVER_DID=did:web:bsky.f1r3fly.local
BSKY_ADMIN_PASSWORD=bsky-admin-password-change-me
BSKY_BSYNC_URL=http://bsync:3000
BSKY_BSYNC_API_KEY=change-me-in-production
BSKY_BSYNC_HTTP_VERSION=1.1
MOD_SERVICE_DID=did:web:ozone.f1r3fly.local
MOD_SERVICE_URL=http://ozone:3000
BSKY_DB_POSTGRES_URL=postgresql://postgres:postgres@postgres:5432/atproto
BSKY_DB_POSTGRES_SCHEMA=bsky
BSKY_SERVICE_SIGNING_KEY=ff25b77231f64f323a8d63270f98db3f886ac87b1bd99bf38fc19ff8f0e5ec6f
BSKY_DID_PLC_URL=https://plc.directory
# Dataplane URLs (comma-separated list of dataplane instances)
BSKY_DATAPLANE_URLS=http://dataplane:2585
BSKY_DATAPLANE_HTTP_VERSION=1.1
# Dataplane Repo Subscription - WebSocket URL of PDS to subscribe to
DATAPLANE_REPOSUBSCRIPTION_URLS=ws://pds:2583


# PDS (Personal Data Server)
PDS_SERVICE_DID=did:web:pds.f1r3fly.local
PDS_BSKY_APP_VIEW_URL=http://bsky:2584
PDS_BSKY_APP_VIEW_DID=did:web:bsky.f1r3fly.local
PDS_MOD_SERVICE_URL=http://ozone:3001
PDS_MOD_SERVICE_DID=did:web:ozone.f1r3fly.local
PDS_DB_POSTGRES_URL=postgresql://postgres:postgres@postgres:5432/atproto
PDS_DB_SQLITE_LOCATION=/pds/pds.sqlite
PDS_JWT_SECRET=change-me-in-production
PDS_ADMIN_PASSWORD=admin-password-change-me
PDS_DID_PLC_URL=https://plc.directory
# Hostname: used in DID documents and handle resolution
PDS_HOSTNAME=localhost
PDS_PORT=2583
# Dev mode - allows http URLs for local development
PDS_DEV_MODE=true
# Invite codes - set to false for testing/dev environments
PDS_INVITE_REQUIRED=false
PDS_SERVICE_HANDLE_DOMAINS=.bsky.social
# PLC rotation key (K256 private key in hex format)
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=08d477959b84a7e36772a31c81dcc2779a62630f3b72899472ed672cf41db4ba
# Blobstore configuration (use local disk storage)
PDS_BLOBSTORE_DISK_LOCATION=/pds/blocks
PDS_BLOBSTORE_DISK_TMP_LOCATION=/pds/tmp

# BSYNC (Background Sync Service)
BSYNC_DB_POSTGRES_URL=postgresql://postgres:postgres@postgres:5432/atproto
BSYNC_DB_POSTGRES_SCHEMA=bsync
BSYNC_API_KEYS=change-me-in-production
BSYNC_DID_PLC_URL=https://plc.directory
BSYNC_DB_MIGRATE=true

# OZONE (Moderation Service)
OZONE_PORT=3001
OZONE_APPVIEW_URL=http://bsky:2584
OZONE_APPVIEW_DID=did:web:bsky.f1r3fly.local
OZONE_PDS_URL=http://pds:2583
OZONE_PDS_DID=did:web:pds.f1r3fly.local
OZONE_DB_POSTGRES_URL=postgresql://postgres:postgres@postgres:5432/atproto
OZONE_SIGNING_KEY_HEX=5ddaaff8f7b96592d49fe311681feae702cf0921bb77510a2a01b94453ae9a9a
OZONE_DID_PLC_URL=https://plc.directory
OZONE_SERVER_DID=did:web:ozone.f1r3fly.local
OZONE_ADMIN_DIDS=
OZONE_ADMIN_PASSWORD=ozone-admin-password-change-me
# Public URL: how Ozone is accessed from the host
OZONE_PUBLIC_URL=http://localhost:3101

# Blockchain node integration (rnode)
DEPLOY_SERVICE_URL=http://rnode.validator1:40401
PROPOSE_SERVICE_URL=http://rnode.validator1:40402
READ_NODE_URL=http://rnode.readonly:40403
READ_NODE_WS_URL=ws://rnode.readonly:40403
DEFAULT_WALLET_KEY=232DADA5BBAFC0799D5F370DA04AF70CE438F69F954512B26D6FB5B560B81DFE
DEFAULT_WALLET_ADDRESS=1111EjdAxnKb5zKUc8ikuxfdi3kwSGH7BJCHKWjnVzfAF3SjCBvjh
# EXPO_PUBLIC vars: browser-side URLs (must be accessible from user's browser, not Docker hostnames)
# These are passed as build args to the f1r3sky Dockerfile and baked into the JS bundle.
EXPO_PUBLIC_EMBERS_API_URL=http://localhost:8080
EXPO_PUBLIC_EMBERS_URL=http://localhost:5173
