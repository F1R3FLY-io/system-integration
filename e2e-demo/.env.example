# GitHub Personal Access Token with read:packages scope
# Required to install @f1r3fly-io packages from GitHub Packages registry
# Get one at: https://github.com/settings/tokens (classic token with read:packages)
# Or use: gh auth token
NPM_TOKEN=

# Override defaults (all optional)
# EMBERS_API_URL=http://localhost:8080
# EMBERS_WS_URL=ws://localhost:8080
# PDS_URL=http://localhost:2583
# SHARD_URL=http://localhost:40403
# PRIVATE_KEY=5f668a7ee96d944a4494cc947e4005e172d7ab3461ee5538f1f2a45a835e9657
# PHLO_LIMIT=10000000
# FIRESKY_USER_HANDLE=user1.test
# FIRESKY_USER_PASSWORD=password123
# FIRESKY_AGENT_PASSWORD=agentpass123
# FIRESKY_AGENT_EMAIL=e2e-agent@test.invalid

# Timeouts (ms)
# TIMEOUT_HEALTH=60000
# TIMEOUT_CREATE=120000
# TIMEOUT_SAVE=120000
# TIMEOUT_DEPLOY=180000
# TIMEOUT_RUN=180000
# TIMEOUT_PUBLISH=180000
# TIMEOUT_RUN_FIRESKY=180000
