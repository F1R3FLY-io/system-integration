# F1R3FLY Dev Stack Environment
# Used by: docker-compose.dev.yml
#
# Encryption keys match local Makefile.toml (services/embers/packages/embers/Makefile.toml)
# Database credentials match local dev-infra (pg:password)
# All URLs use Docker service hostnames (not localhost)

# ============================================================
# PostgreSQL (matching dev-infra credentials)
# ============================================================
POSTGRES_USER=pg
POSTGRES_PASSWORD=password
POSTGRES_DB=postgres

# ============================================================
# Logging
# ============================================================
LOG_ENABLED=true
LOG_LEVEL=debug
NODE_ENV=development

# ============================================================
# Redis (Docker hostname)
# ============================================================
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================================
# BSKY AppView
# ============================================================
BSKY_PUBLIC_URL=http://localhost:2584
BSKY_SERVER_DID=did:web:bsky
BSKY_ADMIN_PASSWORD=admin-pass
BSKY_BSYNC_URL=http://bsync:3000
BSKY_BSYNC_API_KEY=change-me-in-production
BSKY_BSYNC_HTTP_VERSION=1.1
BSKY_DB_POSTGRES_URL=postgresql://pg:password@postgres:5432/postgres
BSKY_DB_POSTGRES_SCHEMA=bsky
# Static signing key for consistent DID across restarts (from dev-env source)
BSKY_SERVICE_SIGNING_KEY=3f916c70dc69e4c5e83877f013325b11ecac31742e6a42f5c4fb240d0703d9d5
BSKY_DID_PLC_URL=http://plc:2582
BSKY_DATAPLANE_URLS=http://dataplane:2585
BSKY_DATAPLANE_HTTP_VERSION=1.1
DATAPLANE_REPOSUBSCRIPTION_URLS=ws://pds:2583

# Moderation service
MOD_SERVICE_DID=did:web:ozone
MOD_SERVICE_URL=http://ozone:3001

# ============================================================
# PDS (Personal Data Server) - No blockchain integration
# ============================================================
PDS_SERVICE_DID=did:web:pds
PDS_BSKY_APP_VIEW_URL=http://bsky:2584
PDS_BSKY_APP_VIEW_DID=did:web:bsky
PDS_MOD_SERVICE_URL=http://ozone:3001
PDS_MOD_SERVICE_DID=did:web:ozone
PDS_DB_POSTGRES_URL=postgresql://pg:password@postgres:5432/postgres
PDS_DB_SQLITE_LOCATION=/pds/pds.sqlite
PDS_JWT_SECRET=jwt-secret
PDS_ADMIN_PASSWORD=admin-pass
PDS_DID_PLC_URL=http://plc:2582
PDS_HOSTNAME=localhost
PDS_PORT=2583
PDS_DEV_MODE=true
PDS_INVITE_REQUIRED=false
PDS_SERVICE_HANDLE_DOMAINS=.bsky.social
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=08d477959b84a7e36772a31c81dcc2779a62630f3b72899472ed672cf41db4ba
PDS_BLOBSTORE_DISK_LOCATION=/pds/blocks
PDS_BLOBSTORE_DISK_TMP_LOCATION=/pds/tmp

# ============================================================
# BSYNC (Background Sync Service)
# ============================================================
BSYNC_DB_POSTGRES_URL=postgresql://pg:password@postgres:5432/postgres
BSYNC_DB_POSTGRES_SCHEMA=bsync
BSYNC_API_KEYS=change-me-in-production
BSYNC_DID_PLC_URL=http://plc:2582
BSYNC_DB_MIGRATE=true

# ============================================================
# OZONE (Moderation Service)
# ============================================================
OZONE_PORT=3001
OZONE_DB_POSTGRES_SCHEMA=ozone_db
OZONE_APPVIEW_URL=http://bsky:2584
OZONE_APPVIEW_DID=did:web:bsky
OZONE_PDS_URL=http://pds:2583
OZONE_PDS_DID=did:web:pds
OZONE_DB_POSTGRES_URL=postgresql://pg:password@postgres:5432/postgres
OZONE_SIGNING_KEY_HEX=5ddaaff8f7b96592d49fe311681feae702cf0921bb77510a2a01b94453ae9a9a
OZONE_DID_PLC_URL=http://plc:2582
OZONE_SERVER_DID=did:web:ozone
OZONE_ADMIN_DIDS=
OZONE_ADMIN_PASSWORD=admin-pass
OZONE_PUBLIC_URL=http://localhost:2587

# ============================================================
# Embers API (encryption keys from local Makefile.toml)
# ============================================================
EMBERS__PORT=3000
EMBERS__ADDRESS=::
EMBERS__LOG_LEVEL=debug
RUST_BACKTRACE=full

# AES encryption key (shared across environments)
EMBERS__AES_ENCRYPTION_KEY=48E37E0E448C482ADEAE83CD15FE91AA4E2459ED67D707BB40EF17BB18E60EE4

# Mainnet keys (from Makefile.toml - matches local dev)
EMBERS__MAINNET__SERVICE_KEY=232DADA5BBAFC0799D5F370DA04AF70CE438F69F954512B26D6FB5B560B81DFE
EMBERS__MAINNET__WALLETS_ENV_KEY=8BDC54B5551812C43428EB172A2079ABBEF13B5370BB7535F78807CDEBA3E7B3
EMBERS__MAINNET__AGENTS_ENV_KEY=69D4BC8ED86915383E68FAF1E4F9D8E22E02CDD3702730C61FE3B45FBBDF0097
EMBERS__MAINNET__AGENTS_TEAMS_ENV_KEY=85348C6D6AEF0B4761F8B8047111B3A2F7C9DF8CB24F91B66B77893DDE21DEE5
EMBERS__MAINNET__OSLFS_ENV_KEY=E6441631C4E164BF13A0532BF6775606965089CE3750E5ED39AAA9EC0DF81E67

# Testnet keys (from Makefile.toml - separate from mainnet)
EMBERS__TESTNET__SERVICE_KEY=732240A471E12931D858F147165BA1B52C011B92B9E8CD7959AADF06D7ACE622
EMBERS__TESTNET__ENV_KEY=D1BD29C232D11142E852EEE23482B239AF5494DFA10D64E82A72A8CDF82D5127
